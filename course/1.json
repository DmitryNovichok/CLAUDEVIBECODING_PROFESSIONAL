"100\" cy=\"128\" r=\"14\"/><text x=\"100\" y=\"133\">Д</text></g><g><circle cx=\"139\" cy=\"75\" r=\"14\"/><text x=\"139\" y=\"80\">Е</text></g><g><circle cx=\"178\" cy=\"75\" r=\"14\"/><text x=\"178\" y=\"80\">Ж</text></g></svg><table class=\"sl-tab sl-adj xs\"><tr><th></th><th>П1</th><th>П2</th><th>П3</th><th>П4</th><th>П5</th><th>П6</th><th>П7</th></tr><tr><th>П1</th><td class=\"x\"></td><td class=\"\">*</td><td class=\"\">*</td><td class=\"\"></td><td class=\"\"></td><td class=\"\"></td><td class=\"\"></td></tr><tr><th>П2</th><td class=\"\">*</td><td class=\"x\"></td><td class=\"\"></td><td class=\"\">*</td><td class=\"\"></td><td class=\"\">*</td><td class=\"\">*</td></tr><tr><th>П3</th><td class=\"\">*</td><td class=\"\"></td><td class=\"x\"></td><td class=\"\"></td><td class=\"\">*</td><td class=\"\"></td><td class=\"\">*</td></tr><tr><th>П4</th><td class=\"\"></td><td class=\"\">*</td><td class=\"\"></td><td class=\"x\"></td><td class=\"\"></td><td class=\"\">*</td><td class=\"\">*</td></tr><tr><th>П5</th><td class=\"\"></td><td class=\"\"></td><td class=\"\">*</td><td class=\"\"></td><td class=\"x\"></td><td class=\"\"></td><td class=\"\"></td></tr><tr><th>П6</th><td class=\"\"></td><td class=\"\">*</td><td class=\"\"></td><td class=\"\">*</td><td class=\"\"></td><td class=\"x\"></td><td class=\"\"></td></tr><tr><th>П7</th><td class=\"\"></td><td class=\"\">*</td><td class=\"\">*</td><td class=\"\">*</td><td class=\"\"></td><td class=\"\"></td><td class=\"x\"></td></tr></table><p>Номера пунктов В и Е (по возрастанию)?</p></div></div>\n<p class=\"sl-note\">Решите руками, а потом проверьте программой из окна Python. Ответы и решения — на следующих слайдах.</p>"
