[Unit]
Description=Independent Python verifier for Egeshka
ConditionUser=ege-python

[Service]
Type=simple
WorkingDirectory=/opt/ege-python-verifier
Environment=HOME=/var/lib/ege-python
Environment=XDG_CONFIG_HOME=/var/lib/ege-python/.config
Environment=XDG_DATA_HOME=/var/lib/ege-python/.local/share
Environment=XDG_CACHE_HOME=/var/lib/ege-python/.cache
Environment=XDG_RUNTIME_DIR=/run/user/%U
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/%U/bus
ExecStart=/usr/bin/python3 /opt/ege-python-verifier/python_executor.py
Restart=on-failure
RestartSec=5
UMask=0077
Delegate=yes
TasksMax=192
MemoryMax=768M
LimitNOFILE=512
KillMode=control-group
TimeoutStopSec=15
# This is a dedicated rootless USER service. Podman's newuidmap/newgidmap
# helpers need their normal OS permissions. The pupil container itself always
# has no-new-privileges, zero capabilities and a non-root UID, checked before exec.

[Install]
WantedBy=default.target
